    "/api/subtypes": {
      "get": {
        "tags": [
          "subtypes"
        ],
        "summary": "Subtypes",
        "operationId": "subtypes_api_subtypes_get",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "web_game_asset",
              "title": "Type"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "match",
              "title": "Status"
            }
          },
          {
            "name": "label",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Label"
            }
          },
          {
            "name": "sample",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Sample"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubtypePage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/subtype/{h}/{sub}": {
      "post": {
        "tags": [
          "subtypes"
        ],
        "summary": "Answer",
        "operationId": "answer_api_subtype__h___sub__post",
        "parameters": [
          {
            "name": "h",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "H"
            }
          },
          {
            "name": "sub",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sub"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubtypeAnswer"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ok"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/thumb/{h}": {
      "get": {
        "tags": [
          "media"
        ],
        "summary": "Thumb",
        "operationId": "thumb_api_thumb__h__get",
        "parameters": [
          {
            "name": "h",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "H"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "the image, or a placeholder drawing",
            "content": {
              "image/jpeg": {},
              "image/svg+xml": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/view/{h}": {
      "get": {
        "tags": [
          "media"
        ],
        "summary": "View",
        "operationId": "view_api_view__h__get",
        "parameters": [
          {
            "name": "h",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
