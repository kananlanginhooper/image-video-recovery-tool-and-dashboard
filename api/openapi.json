        "required": [
          "hash",
          "grp",
          "kind",
          "class",
          "taken",
          "taken_source",
          "size",
          "width",
          "height",
          "duration",
          "folder",
          "st",
          "hidden",
          "playable",
          "prev",
          "next",
          "extras",
          "copies",
          "derived",
          "ocr"
        ],
        "title": "Item"
      },
      "Login": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "issuer": {
            "type": "string",
            "title": "Issuer"
          },
          "clientId": {
            "type": "string",
            "title": "Clientid"
          }
        },
        "type": "object",
        "required": [
          "enabled",
          "issuer",
          "clientId"
        ],
        "title": "Login"
      },
      "Meta": {
        "properties": {
          "classes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Classes"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          },
          "subtypes": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Subtypes"
          },
          "status": {
            "$ref": "#/components/schemas/StatusInfo"
          },
          "class_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Class Counts"
          }
        },
        "type": "object",
        "required": [
          "classes",
          "page_size",
          "subtypes",
          "status",
          "class_counts"
        ],
        "title": "Meta"
      },
      "Ocr": {
        "properties": {
