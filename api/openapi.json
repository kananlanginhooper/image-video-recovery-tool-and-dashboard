        },
        "type": "object",
        "title": "Ok"
      },
      "RuntimeConfig": {
        "properties": {
          "apiBase": {
            "type": "string",
            "title": "Apibase"
          },
          "basePath": {
            "type": "string",
            "title": "Basepath"
          },
          "publicUrl": {
            "type": "string",
            "title": "Publicurl"
          },
          "frameParents": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Frameparents"
          },
          "login": {
            "$ref": "#/components/schemas/Login"
          }
        },
        "type": "object",
        "required": [
          "apiBase",
          "basePath",
          "publicUrl",
          "frameParents",
          "login"
        ],
        "title": "RuntimeConfig"
      },
      "Stats": {
        "properties": {
          "rows": {
            "items": {
              "$ref": "#/components/schemas/StatsRow"
            },
            "type": "array",
            "title": "Rows"
