                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/frame/{h}/{t}": {
      "get": {
        "tags": [
          "media"
        ],
        "summary": "Frame",
        "operationId": "frame_api_frame__h___t__get",
        "parameters": [
          {
            "name": "h",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "H"
            }
          },
          {
            "name": "t",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "T"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "the image, or a placeholder drawing",
            "content": {
              "image/jpeg": {},
              "image/svg+xml": {}
            }
          },
          "422": {
            "description": "Validation Error",
