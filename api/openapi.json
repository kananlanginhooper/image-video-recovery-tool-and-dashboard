{
  "openapi": "3.1.0",
  "info": {
    "title": "Media library",
    "description": "Browse a recovered photo and video library and answer the classifier's questions about it.",
    "version": "1.0"
  },
  "paths": {
    "/api/config": {
      "get": {
        "tags": [
          "config"
        ],
        "summary": "Runtime Config",
        "description": "Loaded by the UI before it starts: nothing about hosts, ports or paths is compiled into it.",
        "operationId": "runtime_config_api_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeConfig"
                }
              }
            }
          }
        }
      }
    },
    "/api/meta": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Meta",
        "operationId": "meta_api_meta_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Meta"
                }
              }
            }
          }
        }
      }
    },
    "/api/browse": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Browse",
        "description": "120 per page, newest first; `ctx` in the answer is this list, for the viewer's previous/next.",
        "operationId": "browse_api_browse_get",
        "parameters": [
          {
            "name": "grp",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "image",
                "video",
                "all",
                ""
              ],
              "type": "string",
              "default": "",
              "title": "Grp"
            }
          },
          {
            "name": "class",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Class"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Status"
            }
          },
          {
            "name": "folder",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Folder"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "From"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "To"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "OCR text search (boolean mode)",
              "default": "",
              "title": "Q"
            },
            "description": "OCR text search (boolean mode)"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "new",
                "old",
                ""
              ],
              "type": "string",
              "default": "",
              "title": "Sort"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrowsePage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/folders": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Folders",
        "operationId": "folders_api_folders_get",
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Prefix"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FolderList"
                }
              }
