    "/api/file/{h}": {
      "get": {
        "tags": [
          "media"
        ],
        "summary": "Original",
        "operationId": "original_api_file__h__get",
        "parameters": [
          {
            "name": "h",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
