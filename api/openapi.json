          }
        ],
        "responses": {
          "200": {
            "description": "the image, or a placeholder drawing",
            "content": {
              "image/jpeg": {},
              "image/svg+xml": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
