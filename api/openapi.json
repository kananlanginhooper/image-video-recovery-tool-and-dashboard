  "components": {
    "schemas": {
      "BrowsePage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Tile"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "pages": {
            "type": "integer",
            "title": "Pages"
          },
          "ctx": {
            "type": "string",
            "title": "Ctx",
            "description": "the list, for the viewer's previous/next (pass back as ?ctx=)"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "pages",
          "ctx"
        ],
        "title": "BrowsePage"
      },
      "Copy": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Size"
          }
        },
        "type": "object",
        "required": [
          "path",
          "size"
        ],
        "title": "Copy"
      },
      "Derived": {
        "properties": {
          "derivation": {
            "type": "string",
            "title": "Derivation"
          },
          "path": {
            "type": "string",
            "title": "Path"
          }
        },
        "type": "object",
        "required": [
          "derivation",
          "path"
        ],
        "title": "Derived"
      },
      "Extra": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "label",
          "text"
        ],
        "title": "Extra",
        "description": "A plugin's line in the item details; any other keys make it a link handed back to the plugin."
      },
      "FolderList": {
        "properties": {
          "prefix": {
            "type": "string",
            "title": "Prefix"
          },
          "here": {
            "type": "integer",
            "title": "Here",
            "description": "items directly in the prefix folder"
          },
          "folders": {
            "items": {
              "$ref": "#/components/schemas/FolderRow"
            },
            "type": "array",
            "title": "Folders"
          }
        },
        "type": "object",
        "required": [
          "prefix",
          "here",
          "folders"
        ],
        "title": "FolderList"
      },
      "FolderRow": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "n": {
            "type": "integer",
            "title": "N"
          },
          "v": {
            "type": "integer",
            "title": "V",
            "description": "videos"
          }
        },
        "type": "object",
        "required": [
          "path",
          "name",
          "n",
          "v"
        ],
        "title": "FolderRow"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "items": {
            "type": "integer",
            "title": "Items"
          },
          "at": {
            "type": "string",
            "title": "At"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "items",
          "at"
        ],
        "title": "Health"
      },
      "Item": {
        "properties": {
          "hash": {
            "type": "string",
            "title": "Hash"
          },
          "grp": {
            "type": "string",
            "title": "Grp"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "class": {
            "type": "string",
            "title": "Class"
          },
          "taken": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Taken"
          },
          "taken_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Taken Source"
          },
          "size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Size"
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width"
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height"
          },
          "duration": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration"
          },
          "folder": {
            "type": "string",
            "title": "Folder"
          },
          "st": {
            "type": "string",
            "title": "St"
          },
          "hidden": {
            "type": "boolean",
            "title": "Hidden"
          },
          "playable": {
            "type": "boolean",
            "title": "Playable"
          },
          "prev": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prev"
          },
          "next": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next"
          },
          "extras": {
            "items": {
              "$ref": "#/components/schemas/Extra"
            },
            "type": "array",
            "title": "Extras"
          },
          "copies": {
            "items": {
              "$ref": "#/components/schemas/Copy"
            },
            "type": "array",
            "title": "Copies"
          },
          "derived": {
            "items": {
              "$ref": "#/components/schemas/Derived"
            },
            "type": "array",
            "title": "Derived"
          },
          "ocr": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Ocr"
              },
              {
                "type": "null"
