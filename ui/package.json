{
  "name": "media",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "build:demo": "node -e \"const fs=require('fs');for(const f of fs.existsSync('../docs')?fs.readdirSync('../docs'):[])if(f!=='refactor')fs.rmSync('../docs/'+f,{recursive:true,force:true})\" && ng build --configuration demo && node -e \"require('fs').copyFileSync('../docs/index.html','../docs/404.html');require('fs').writeFileSync('../docs/.nojekyll','')\"",
    "start:demo": "ng serve --configuration demo",
    "gen:api": "openapi-typescript ../api/openapi.json -o src/app/core/api-types.ts",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "date-fns": "^4.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.37",
    "@angular/cli": "^20.3.37",
    "@angular/compiler-cli": "^20.3.0",
    "@eslint/js": "^9.39.5",
    "angular-eslint": "^20.7.0",
    "eslint": "^9.39.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.4"
  }
}
