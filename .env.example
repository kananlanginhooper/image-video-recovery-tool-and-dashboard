# Copy to .env next to docker-compose.yml and adjust. Values shown are the defaults.

# Address and port the app listens on (host networking: an address of this machine). No login: keep it on your LAN.
MEDIA_HOST=0.0.0.0
MEDIA_PORT=8093

# MySQL client config ([client] host, user, password, database) for the catalogue, mounted read-only.
MEDIA_DB_CNF=./db.cnf

# Where generated thumbnails, viewer JPEGs and video frames are cached (writable).
MEDIA_CACHE_DIR=./cache

# User the app runs as: must be able to read the DB config and the media files, and write the cache.
MEDIA_UID=1000
MEDIA_GID=1000

# Value written to decided_by when you answer a review question.
MEDIA_REVIEWER=owner

# "private" builds the UI with the plugins in ui/src/private (see README "Plugins").
UI_CONFIG=production

# The "refresh" profile: SQL that rebuilds media_browse, and how often (seconds).
REFRESH_SQL=./api/private/media_browse_refresh.sql
REFRESH_EVERY=1800
