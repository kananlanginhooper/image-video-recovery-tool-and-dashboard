# Copy to .env next to docker-compose.yml and adjust. Values shown are the defaults.

# On the machine that has the media files, also mount them (see compose.files.yml):
# COMPOSE_FILE=docker-compose.yml:compose.files.yml
# On Docker Desktop (Windows/macOS), publish the port instead of host networking (see compose.bridge.yml; on Windows
# separate the files with ";" instead of ":"):
# COMPOSE_FILE=docker-compose.yml:compose.bridge.yml

# Address and port the app listens on (host networking: an address of this machine). No login: keep it on your LAN.
MEDIA_HOST=0.0.0.0
MEDIA_PORT=8093

# Where the app lives and who may show it in an iframe. Only these change when it moves from http://<ip>:<port>
# to https://<app>.<domain>. FRAME_ANCESTORS lists the Home dashboards wrapper origins (laptop wrapper, server wrapper,
# later the wrapper's subdomain), so the wrapper can always frame the app.
PUBLIC_URL=
UI_BASE_PATH=/
FRAME_ANCESTORS=http://localhost:4310 http://192.0.2.10:8097
# Behind a reverse proxy: the proxy's address(es), so X-Forwarded-Proto/For are honored.
FORWARDED_ALLOW_IPS=127.0.0.1
# Login (OpenID Connect client; not built yet): on/off, issuer URL, client id.
LOGIN=off
OIDC_ISSUER=
OIDC_CLIENT_ID=

# The catalogue database (MySQL). Same values on the laptop and the server: DB_HOST is the database server's LAN address.
DB_HOST=192.0.2.10
DB_PORT=3306
DB_NAME=catalogue
DB_USER=media_library
DB_PASSWORD=change-me
# Or leave DB_USER empty and point this at a MySQL client config file ([client] host, user, password, database).
MEDIA_DB_CNF=./db.cnf

# On a machine without the media files (e.g. a laptop): base URL of an instance that has them; media is streamed from it.
MEDIA_FILES_UPSTREAM=

# Where generated thumbnails, viewer JPEGs and video frames are cached (writable).
MEDIA_CACHE_DIR=./cache

# User the app runs as: must be able to read the DB config and the media files, and write the cache.
MEDIA_UID=1000
MEDIA_GID=1000

# Value written to decided_by when you answer a review question.
MEDIA_REVIEWER=owner

# "private" builds the UI with the plugins in ui/src/private (see README "Plugins").
UI_CONFIG=production

# The "refresh" profile: SQL that rebuilds media_browse, and how often (seconds).
REFRESH_SQL=./api/private/media_browse_refresh.sql
REFRESH_EVERY=1800
